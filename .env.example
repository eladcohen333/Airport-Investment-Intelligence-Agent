# --- LLM runtime -------------------------------------------------------------
# Provider selection: auto | anthropic | gemini | demo
#   auto = Anthropic if ANTHROPIC_API_KEY is set, else Gemini if GEMINI_API_KEY is set, else Demo / deterministic mode
LLM_PROVIDER=auto

# Anthropic (default runtime per the brief)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Gemini (alternative runtime, used when only a Gemini key is available)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the primary model is overloaded (HTTP 503)
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite

# --- Live operational context (optional) --------------------------------------
AVIATIONSTACK_API_KEY=
AVIATIONSTACK_BASE_URL=https://api.aviationstack.com/v1

# --- Local data store -----------------------------------------------------------
DUCKDB_PATH=data/airport_intelligence.duckdb

# --- Analysis defaults ----------------------------------------------------------
LONG_HAUL_THRESHOLD_MILES=2000
MIN_REPORTED_FLIGHTS=500
DEMO_SCOPE_START=2023-01
NATIONWIDE_SCOPE_START=2019-01

# --- Logging ----------------------------------------------------------------------
LOG_LEVEL=INFO
